# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local development — SQLite, no server needed:
DATABASE_URL="file:./dev.db"

# Production — Postgres. Paste the connection string from Neon / Supabase /
# Vercel Postgres instead. The Prisma provider follows this URL automatically
# (scripts/set-db-provider.mjs, run by `npm run build` and `npm run db:deploy`),
# so nothing else changes:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
#
# On serverless hosts (Vercel), use your provider's POOLED connection string
# here. Use the DIRECT (unpooled) one when running `npm run db:deploy`.

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Any long random string. Generate one with: openssl rand -base64 32
# Use a different value in production from the one you use locally.
AUTH_SECRET="change-me-to-a-long-random-string"

# Auth.js trusts the host header in development; keep this on for localhost.
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
# Password given to every seeded account. Defaults to "nirf1234" when unset,
# which is fine locally — set a real one before seeding a public database.
# SEED_PASSWORD="choose-something-private"
