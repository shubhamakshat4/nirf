# SQLite for local development. Switch the Prisma provider to postgresql and
# point this at a Postgres URL to move off SQLite; nothing else changes.
DATABASE_URL="file:./dev.db"

# Any long random string. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Auth.js trusts the host header in development; keep this on for localhost.
AUTH_TRUST_HOST=true
